# Copie este arquivo para .env e preencha com seus dados

# Seu Personal API Token do ClickUp
# Encontre em: Configurações → Meu Perfil → Aplicativos → API Token
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID da Lista do ClickUp que você quer monitorar
# Aparece na URL quando você abre a lista: app.clickup.com/.../<LIST_ID>/...
# Ou clique com botão direito na lista → Copiar link → o número no final é o ID
CLICKUP_LIST_ID=xxxxxxxxxx

# Porta do servidor (opcional, padrão: 3000)
PORT=3000
